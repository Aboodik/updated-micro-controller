  (text "Output Protection - 3x TI eFuse (resettable)" (at 25.4 22.86 0)
    (effects (font (size 2.54 2.54) bold) (justify left bottom))
    (uuid 49d410bf-00b3-457e-80dc-28da79d5e920)
  )
  (text "EN pins default ON via 10k pull-ups on the MCU sheet (10k beats the RP2040 50-80k boot pull-down); MCU pulls EN low to turn a rail off or reset a fault." (at 25.4 27.94 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 917305f0-cc56-46b7-a580-93f87f8be727)
  )
  (text "OVLO dividers cut the output if the input is too high (5V rails: 6.0V, 12V rail: 14.1V). Unlabelled triangles = GND." (at 25.4 31.75 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid ca9683a4-deee-4e04-b151-f045bd3009ca)
  )
  (text "U201 - 5V 3A USB output (also replaces the 'Switch' block)" (at 134.62 45.72 0)
    (effects (font (size 2.0 2.0) bold) (justify left bottom))
    (uuid 4d84c9f3-9631-4e31-bade-0197090f6bf5)
  )
